# ==============================================================================
# Amrutam Telemedicine Backend — Environment Configuration Template
# ==============================================================================

# Node Environment: development | test | production
NODE_ENV=development

# Server Port
PORT=5000

# PostgreSQL Connection String (Prisma format)
DATABASE_URL="postgresql://postgres:password@localhost:5432/amrutam_telemedicine?schema=public"

# Direct URL for running database schema migrations (unpooled)
DIRECT_URL="postgresql://postgres:password@localhost:5432/amrutam_telemedicine?schema=public"

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET="replace_with_a_secure_random_32_character_string_for_access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace_with_a_secure_random_32_character_string_for_refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key for Sensitive Fields (MFA secrets at rest)
MFA_ENCRYPTION_KEY="replace_with_a_secure_random_32_character_string_for_mfa_encryption"

# Allowed CORS Origins (comma-separated or single URL)
CORS_ORIGIN="http://localhost:3000"

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Active provider: MOCK | RAZORPAY
PAYMENT_PROVIDER="MOCK"
PAYMENT_WEBHOOK_SECRET="replace_with_a_secure_random_32_character_string_webhook_secret"

# Razorpay Production Credentials (Required when PAYMENT_PROVIDER=RAZORPAY)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ------------------------------------------------------------------------------
# Telemedicine Video Consultation Configuration
# ------------------------------------------------------------------------------
# Active provider: MOCK_WEBRTC | JITSI
VIDEO_PROVIDER="MOCK_WEBRTC"
VIDEO_JWT_SECRET="replace_with_a_secure_random_32_character_string_video_jwt"
VIDEO_JITSI_DOMAIN="meet.jit.si"
VIDEO_JITSI_APP_ID="amrutam-telemedicine"

# ------------------------------------------------------------------------------
# Notification Channels Configuration
# ------------------------------------------------------------------------------
# SMTP Email Transport (Optional; logs in dev/test when unset)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@amrutam.co.in"

# Twilio SMS Transport (Optional; logs in dev/test when unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# Performance Benchmark Parameters
# ------------------------------------------------------------------------------
BENCHMARK_CONCURRENCY=10
BENCHMARK_REQUESTS=100
